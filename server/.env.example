# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/medfind

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Admin seed credentials (used only by seed script, never hardcode elsewhere)
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@medfind.local
ADMIN_PASSWORD=ChangeMe123!

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Optional: map/geocoding provider key (app works fine without it, using
# browser geolocation + straight-line distance instead)
MAP_API_KEY=
